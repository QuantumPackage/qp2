def get_rag_inputs(l_module, d_irp):
    """
    Inputs of the `rag` target (root build.ninja): the sorted deduped
    union of the inputs of all the build_irpf90.ninja module edges,
    plus the RAG tool and this generator, so that the corpus is
    rebuilt when any source (or the tool) changes.
    """
    rag_inputs = set()

    for module in l_module:
        if module.rel == "dummy":
            continue

        for f in d_irp[module]["l_depend"] + d_irp[module]["l_template"]:
            rag_inputs.add(comp_path(f))

    rag_inputs.add(comp_path(join(QP_ROOT, "scripts", "rag", "qp_rag.py")))
    rag_inputs.add(comp_path(join(QP_ROOT, "scripts", "compilation",
                                  "qp_create_ninja")))

    return sorted(rag_inputs)


