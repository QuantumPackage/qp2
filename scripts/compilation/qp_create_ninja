def _positive_int_from_env(name, default):
    """
    Return the positive integer held by the environment variable `name`.

    Unset, empty or malformed values return `default`: a typo in a build knob
    must not break the build (this is also how IRPF90_NTHREADS behaves).
    """
    value = os.getenv(name)
    if value is None or not value.strip():
        return default
    try:
        number = int(value)
    except ValueError:
        number = 0
    if number <= 0:
        print("Warning: ignoring {0}={1!r}, using {2}".format(name, value,
                                                              default))
        return default
    return number


def build_parallelism():
    """
    Return (jobs, modules, jobs_per_module) for the build pools.

    jobs            : QP_BUILD_JOBS, the total process budget
    modules         : QP_BUILD_MODULES, modules built concurrently
    jobs_per_module : IRPF90_NTHREADS, IRPF90 workers and nested-ninja jobs
                      of one module
    """
    jobs = _positive_int_from_env("QP_BUILD_JOBS", os.cpu_count() or 1)
    modules = _positive_int_from_env("QP_BUILD_MODULES",
                                     max(1, min(8, jobs // 8)))
    modules = min(modules, jobs)
    per_module = _positive_int_from_env("IRPF90_NTHREADS",
                                        max(1, jobs // modules))
    return jobs, modules, per_module


def _flag_value(pwd_config_file, flag):
    """
    The value of a compilation flag: the value of the configuration
    file plus the content of every per-module <flag> file found in
    src/ (e.g. src/utils/CFLAGS, src/trexio/LIB), in sorted module
    order. Shared by the ninja and the make variable blocks so that
    both build systems see identical values.
    """
    str_ = get_compilation_option(pwd_config_file, flag)
    for directory in [real_join(QP_SRC, m)
                      for m in sorted(os.listdir(QP_SRC))]:
        includefile = real_join(directory, flag)
        try:
            content = ""
            with open(includefile, 'r') as f:
                content = f.read().strip()
                str_ += " " + content
        except IOError:
            pass
    return str_


def ninja_create_env_variable(pwd_config_file, jobs, modules, per_module):
    """
    Return some ninja variable with the env variable expanded
    FC, CC, FCFLAGS, CFLAGS, IRPF90, IRPF90_FLAGS
    The env variable is useful for the generation of EZFIO, and IRPF90
    """
    l_string = ["builddir = {0}".format(os.path.dirname(ROOT_BUILD_NINJA)),
                "# QP_BUILD_JOBS={0}: {1} modules x {2} jobs".format(
                    jobs, modules, per_module),
                ""]


    for flag in ["FC", "CC", "CFLAGS", "FCFLAGS", "IRPF90", "IRPF90_FLAGS"]:
        l_string.append("{0} = {1}".format(
            flag, _flag_value(pwd_config_file, flag)))

    lib_lapack = get_compilation_option(pwd_config_file, "LAPACK_LIB")
    lib_usr = get_compilation_option(pwd_config_file, "LIB")

    str_lib = " ".join([lib_lapack, EZFIO_LIB, LIB, lib_usr])

    # Read all LIB files in modules
    for directory in [real_join(QP_SRC, m) for m in sorted(os.listdir(QP_SRC))]:
        libfile = real_join(directory, "LIB")
        try:
            content = ""
            with open(libfile,'r') as f:
                content = f.read().replace('\n','')
                str_lib += " "+content
        except IOError:
            pass

    l_string.append("LIB = {0} ".format(str_lib))


    l_string.append("CONFIG_FILE = {0}".format(pwd_config_file))
    l_string.append("")

    return l_string


def make_create_env_variable(pwd_config_file, jobs, modules, per_module):
    """
    The variable block of config/Makefile: the values of
    ninja_create_env_variable (already `FLAG = value` lines, valid make
    assignment syntax; the ninja-specific `builddir =` line is dropped),
    plus:
      - QP_EZFIO and the export of the variables that must reach the
        module make through the environment: a makefile assignment in
        the wrapper would clobber the environment, and the `+=` of
        irpf90.make (FC += -I ...) requires env-sourcing.
      - the shared values carry ninja-style $QP_ROOT references (the
        cfg LIB option, the EZFIO_LIB constant, the per-module LIB
        files); in make, a bare $Q would expand to the (empty) Q
        variable and break the link line, so every $VAR in a value is
        rewritten to the make $(VAR) form, which make itself expands
        to the absolute path before the export.
      - IRPF90_FLAGS_MAKE: IRPF90_FLAGS minus the literal --ninja
        token, which only selects the ninja file generation in irpf90.
    """
    l_string = [s for s in ninja_create_env_variable(pwd_config_file, jobs,
                                                     modules, per_module)
                if not s.startswith("builddir =")]

    l_string = [re.sub(r"\$(\w+)", r"$(\1)", s) if "$" in s else s
                for s in l_string]

    l_string.append("QP_EZFIO = {0}".format(QP_EZFIO))
    l_string.append("export QP_ROOT QP_EZFIO FC CC CFLAGS FCFLAGS LIB")
    irpf90_flags = _flag_value(pwd_config_file, "IRPF90_FLAGS")
    l_string.append("IRPF90_FLAGS_MAKE = {0}".format(
        " ".join(t for t in irpf90_flags.split() if t != "--ninja")))
    l_string.append("")

    return l_string


def create_make_global(l_module, d_genealogy_path, d_irp, l_util,
                       l_ezfio_config, pwd_config_file, jobs, modules,
                       per_module):
    """
    Write config/Makefile: the thin make graph of the QP build. It has
    phony module_<M> targets whose recipes run the same command sequence
    the ninja rules run (NEED symlinks -> sub-make in the module dir);
    all the real incremental dependency tracking happens inside the
    module, through the IRPF90 make-mode files (irpf90.make). One
    generator per layer: the ninja functions above keep writing the
    ninja graph, untouched.
    """
    l_string = make_create_env_variable(pwd_config_file, jobs, modules,
                                        per_module)

    # ~#~#~#~#~#~ #
    # E Z F I O   #
    # ~#~#~#~#~#~ #

    l_string += ["EZFIO_LIB = $(QP_ROOT)/lib/libezfio_irp.a", ""]

    # One cp edge per *.ezfio_config file (same command as the ninja
    # build_ezfio_config rule).
    for m in l_ezfio_config:
        l_string += ["{0}: {1}".format(m.path_in_ezfio, m.path_in_module),
                     "\tcp \"$<\" \"$@\"", ""]

    # One ei_handler edge per module with an EZFIO.cfg (same invocation
    # as the ninja build_ezfio_interface rule; the interface file in the
    # module is a declared output there, here a side effect consumed by
    # the wrapper Makefile). As in the ninja graph, the generator
    # scripts are inputs of the edge: a change in them regenerates
    # every interface file.
    for m in l_util.values():
        l_string += ["{0}: {1}".format(m.ez_config.abs,
                                       " ".join([m.ez_cfg.abs]
                                                + list(EZFIO_GENERATOR))),
                     "\tcd \"{0}\" && source quantum_package.rc &&"
                     " python3 scripts/ezfio_interface/ei_handler.py"
                     " --path_module {1}".format(QP_ROOT,
                                                 m.ez_module.abs),
                     ""]

    # The ezfio library: serial (no `+`), like the ninja rule's
    # pool = console. The values are baked and quoted, mirroring
    # ninja_ezfio_rule (rm the QP-side symlink, ln it back).
    l_prereq = [m.path_in_ezfio for m in l_ezfio_config] + \
               [m.ez_config.abs for m in l_util.values()]
    l_flag = ["{0}='{1}'".format(flag, _flag_value(pwd_config_file, flag))
              for flag in ["FC", "CC", "FCFLAGS", "CFLAGS", "IRPF90"]]
    l_string += ["$(EZFIO_LIB): {0}".format(" ".join(l_prereq)),
                 "\tcd \"{0}\" && export {1} && make veryclean && make &&"
                 " rm -f \"$(EZFIO_LIB)\" && ln -sf {0}/lib/libezfio_irp.a"
                 " \"$(EZFIO_LIB)\"".format(QP_EZFIO, " ".join(l_flag)),
                 ""]

    # ~#~#~#~#~#~ #
    # T a r g e t s #
    # ~#~#~#~#~#~ #

    l_string += [".DEFAULT_GOAL := rust_target",
                 ".PHONY: rust_target all make_rust clean tidy rag",
                 "",
                 "rust_target: make_rust all",
                 "make_rust:",
                 "\tcd \"{0}\" && source quantum_package.rc &&"
                 " scripts/compilation/build_rust_tools.sh".format(QP_ROOT),
                 "",
                 "all: {0}".format(" ".join("module_{0}".format(m.rel)
                                           for m in l_module
                                           if m.rel != "dummy")),
                 "",
                 "clean:",
                 "\tcd \"{0}\" && source quantum_package.rc &&"
                 " python3 scripts/module/module_handler.py"
                 " clean --all".format(QP_ROOT),
                 "",
                 "tidy:",
                 "\tcd \"{0}\" && source quantum_package.rc &&"
                 " python3 scripts/module/module_handler.py"
                 " tidy --all".format(QP_ROOT),
                 "",
                 "rag:",
                 # The verbatim command of the ninja rag rule (root
                 # build.ninja), run under bash: under make's /bin/sh
                 # (POSIX mode) a missing file inside `source
                 # etc/paths.rc` aborts the sourced file and the &&
                 # chain dies, where bash keeps going.
                 "\tcd \"{0}\""
                 " && bash -c 'source quantum_package.rc &&"
                 " source etc/paths.rc && python3 scripts/rag/qp_rag.py"
                 " build'".format(QP_ROOT),
                 ""]

    # ~#~#~#~#~#~ #
    # M o d u l e s #
    # ~#~#~#~#~#~ #

    for module in l_module:
        if module.rel == "dummy":
            continue

        l_children = d_genealogy_path[module]
        l_symlink = get_source_destination(module, l_children)

        l_string += [".PHONY: module_{0}".format(module.rel),
                     "module_{0}: $(EZFIO_LIB)".format(module.rel)]
        for symlink in sorted(l_symlink,
                              key=lambda x: x.source + x.destination):
            l_string.append("\tln -sfn \"{0}\" \"{1}\"".format(
                symlink.source, symlink.destination))

        # SRC/OBJ reach the module make through the environment (inline
        # assignments, not make command-line variables: those would
        # silently disable the `+=` of irpf90.make). They are
        # module-RELATIVE paths: the pattern rules of irpf90.make are
        # relative (IRPF90_temp/%.o: %.f90) and GNU make pattern rules
        # do not match absolute targets.
        l_src = sorted(os.path.relpath(f, module.abs)
                       for f in d_irp[module]["l_src"])
        l_obj = sorted(os.path.relpath(f, module.abs)
                       for f in d_irp[module]["l_obj"])
        l_string += ["\t+cd \"{0}\" && SRC=\"{1}\" OBJ=\"{2}\""
                     " $(MAKE) -f Makefile all".format(module.abs,
                                                       " ".join(l_src),
                                                       " ".join(l_obj)),
                     ""]

    # ~#~#~#~#~#~ #
    # R A G   B L O C K  (parsed by scripts/rag/qp_rag.py) #
    # ~#~#~#~#~#~ #
    # One qp-rag-dir line per distinct (alias, tree dir) pair: the
    # same information the build_symlink edges carry in the ninja
    # manifest (the authoritative include-dir resolution). One
    # qp-rag-edge line per module: key = $QP_ROOT-relative module dir,
    # dirs = the -I aliases, in the include_dir order of the ninja
    # graph. The dir lines come first: the parser resolves an alias
    # against the dirmap of the preceding lines.
    d_rag_dir = {}
    l_rag_edge = []
    for module in l_module:
        if module.rel == "dummy":
            continue
        l_children = sorted(d_genealogy_path[module],
                            key=lambda x: x.rel + x.abs)
        for child in l_children:
            d_rag_dir.setdefault(child.rel,
                                 os.path.relpath(child.abs, QP_ROOT))
        l_rag_edge.append("# qp-rag-edge: {0}|{1}".format(
            os.path.relpath(module.abs, QP_ROOT),
            " ".join(c.rel for c in l_children)))
    for alias, target in sorted(d_rag_dir.items()):
        l_string.append("# qp-rag-dir: {0} {1}".format(alias, target))
    l_string += l_rag_edge
    l_string.append("")

    # ~#~#~#~#~ #
    # S a v e s   #
    # ~#~#~#~#~ #

    with open(ROOT_MAKE_EXP_tmp, "w+") as f:
        f.write(make_header)
        f.write("\n".join(l_string))

    with open(ROOT_MAKE_EXP_tmp, "r") as f:
        a = f.read()

    try:
        with open(ROOT_MAKE_EXP, "r") as f:
            b = f.read()
    except:
        b = None

    if a != b:
        os.rename(ROOT_MAKE_EXP_tmp, ROOT_MAKE_EXP)
    else:
        os.remove(ROOT_MAKE_EXP_tmp)


def _write_wrapper(path, content):
    """
    Write a generated per-module wrapper Makefile with an
    overwrite guard and a content compare:
      - a Makefile that is not ours (first line != the generation
        header) is left untouched;
      - an unchanged file is not rewritten (mtime churn is fatal:
        Makefile is a prerequisite of irpf90.make, so an unconditional
        rewrite re-runs irpf90 on every build).
    """
    if os.path.exists(path):
        with open(path, "r") as f:
            first = f.readline()
        if first.rstrip("\n") != WRAPPER_HEADER:
            return False
        with open(path, "r") as f:
            if f.read() == content:
                return False

    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(content)
    os.replace(tmp, path)
    return True


def save_makefile_module(path_module, l_children, has_ezfio_cfg, l_src,
                         l_obj, irpf90, irpf90_flags_make):
    """
    Write the per-module wrapper Makefile (path_module/Makefile; for an
    installed plugin module, path_module.abs is the plugins/... real
    location): the local entry point of the make build, replacing the
    per-module build.ninja. The default goal `executables` builds the
    module + the Rust tools, mirroring the ninja per-module
    `default executables`.

    FC/CC/CFLAGS/FCFLAGS/LIB/SRC/OBJ are deliberately NOT assigned
    here: they arrive through the environment (export in
    config/Makefile, inline in the module recipe), and a makefile
    assignment would clobber the environment while the `+=` of
    irpf90.make requires env-sourcing.
    """
    l_include = ["-I {0}".format(m.rel) for m in
                 sorted(l_children, key=lambda x: x.rel + x.abs)]

    # Same platform test as irpf90 (src/makefile.py).
    if sys.platform == "darwin":
        archive = "libtool -static -o"
    else:
        archive = "ar crs"

    if not irpf90.startswith("/"):
        irpf90 = join(QP_ROOT, "external", "irpf90", "bin", "irpf90")

    l_prereq = ["$(wildcard *.irp.f)", "$(wildcard */*.irp.f)",
                "$(wildcard *.template.f)", "$(wildcard *.include.f)",
                "$(wildcard *.ezfio_config)", "NEED", "Makefile"]
    if has_ezfio_cfg:
        l_prereq += ["EZFIO.cfg", "ezfio_interface.irp.f"]

    l_string = [WRAPPER_HEADER,
                "IRPF90 = {0}".format(irpf90),
                "IRPF90_FLAGS = {0}".format(irpf90_flags_make),
                "INCLUDE_DIRS = {0}".format(" ".join(l_include)),
                "ARCHIVE = {0}".format(archive),
                "RANLIB = ranlib",
                "QP_ROOT = {0}".format(QP_ROOT),
                "",
                ".PHONY: executables all",
                "executables: all",
                "\tcd \"$(QP_ROOT)\" && source quantum_package.rc &&"
                " scripts/compilation/build_rust_tools.sh",
                "all:",
                "",
                "irpf90.make: {0} \\".format(" ".join(l_prereq[:-1])),
                "             {0}".format(l_prereq[-1]),
                "\t$(IRPF90) $(INCLUDE_DIRS) $(IRPF90_FLAGS)",
                ""]

    # Standalone in-module make support: in the root-graph flow the
    # file is already produced by the $(EZFIO_LIB) chain (present file
    # + rule = plain file dependency, no re-run). The generator
    # scripts are inputs, as in the ninja graph: a change in them
    # regenerates the interface file.
    if has_ezfio_cfg:
        l_string += ["ezfio_interface.irp.f: EZFIO.cfg {0}".format(
            " ".join(EZFIO_GENERATOR)),
                     "\tcd \"{0}\" && source quantum_package.rc &&"
                     " python3 scripts/ezfio_interface/ei_handler.py"
                     " --path_module {1}".format(QP_ROOT,
                                                 path_module.abs),
                     ""]

    l_string += ["-include irpf90.make", "export", ""]

    _write_wrapper(join(path_module.abs, "Makefile"),
                   "\n".join(l_string))


