def ninja_symlink_rule():
    """
    Return the command to create for the symlink
    """
    # $source, not $in: the source is an order-only dependency (see
    # ninja_symlink_build), so it is absent from $in.
    return ["rule build_symlink", "   command =  rm -f $out ; ln -sf $source $out", ""]


def ninja_symlink_build(path_module, l_symlink):
    """
    Create the symlink
    and the l_symlink which are all the symlink list
    """

    if not l_symlink:
        return []

    l_folder = [s.destination for s in sorted(l_symlink,key=lambda x:x.destination)]

    l_string = ["build l_symlink_{0} : phony {1}".format(path_module.rel,
                                                         " ".join(map(comp_path,l_folder))),
                ""]

    for symlink in sorted(l_symlink, key=lambda x: x.source+x.destination):
        destination, source = map(comp_path, (symlink.destination,
                                              symlink.source))
        # `||`, not `|`: only `||` is order-only (`|` is *implicit* and is
        # still compared against the output mtime). ninja stats through a
        # symlink, so a normal dependency would dirty the link whenever the
        # build writes into the target directory (`tags`, the BEGIN_SHELL
        # script) and re-run IRPF90 for every module on every build. `$source`
        # is needed because `$in` excludes order-only dependencies.
        l_string += ["build {0}: build_symlink || {1}".format(destination,
                                                              source),
                     "   source = {0}".format(source), ""]

    return l_string


